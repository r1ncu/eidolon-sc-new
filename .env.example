# 复制成 .env 再填。docker compose 会读这一份。
#
# 两段：上半是对话内核（网页端和群聊共用），下半是 QQ 群通道。
# 密钥只写在这里，别提交、别贴群里；`chmod 600 .env`。

# ---- 对话模型（必填，任何 OpenAI 兼容服务）
CHAT_LLM_BASE_URL=https://api.deepseek.com/v1
CHAT_LLM_API_KEY=
CHAT_LLM_MODEL=deepseek-flash

# ---- 内核
SCCORE_TURNS_PER_HOUR=60
SCCORE_PHOTOS_PER_HOUR=8
SCCORE_HISTORY_TURNS=20
SCCORE_TIMEZONE=Asia/Shanghai
# 资料怎么进提示词：off（只有人设）/ whole（整份 facts）/ vector（切段检索）
SCCORE_RECALL=whole
# SCCORE_JUDGE_MODEL=          # 留空用对话模型当判官；填别的模型名就用它
# FISH_AUDIO_API_KEY=          # 填了语音插件才开，否则自动关闭
# SCCORE_CALL=auto            # 电话：auto（默认，跟 FISH_AUDIO_API_KEY 走）/ off（手动关）/ on
#                             # 没配语音时她不提打电话，页面也不画电话键

# ---- QQ 群通道
QQ_ENABLED=1
# 用哪位角色的人格：characters/characters.toml 里的 id。它也决定
# characters/world/<id>-qq.md / -dm.md / -stage.toml / -refusals.toml 叫什么。
# 必填。示例：QQ_CHARACTER=aoi（就是 characters.example.toml 里的 id）
QQ_CHARACTER=
# 机器人自己的号（小号），用来过滤它自己发的消息、判断有没有被 @
QQ_SELF_ID=
# 只待这一个群。填群号，不是群名。
QQ_GROUP_IDS=
# 谁是「制作人」。决定她怎么称呼你，不影响别人各记各的。
QQ_OWNER_IDS=
# 私聊：默认关。开了以后只有下面名单里的人能一对一找她——那里没有外人在场，
# 她会换一副语气（人设里 <id>-dm.md 那一份）。名单留空则沿用 QQ_OWNER_IDS。
QQ_PRIVATE=0
QQ_PRIVATE_IDS=
# NapCat 里设置的 OneBot 访问令牌；没设就留空
QQ_ONEBOT_TOKEN=
# 连发合并窗口（秒）与同一人的回复冷却（秒）
QQ_MERGE_SECONDS=1.2
QQ_MEMBER_COOLDOWN=20
# 没人 @ 她的时候，她自己插话：一天最多 DAILY 次（所有群加在一起），两次之间至少隔 GAP 秒，
# HEARD 是给她看的最近几行。设 QQ_AMBIENT=0 就只在被 @ 时说话。
# 「插不插」不是掷骰子决定的：她看见这几行，判断有没有她想接的话、要接哪一句——
# 那份判断依据是 characters/world/<角色ID>-interests.md。
QQ_AMBIENT=1
QQ_AMBIENT_DAILY=10
QQ_AMBIENT_GAP=300
# 两次"要不要插话"的判断之间至少隔多少秒。判断是一次模型请求，这个数字只管成本：
# 300 = 每个群五分钟最多看一次群里在聊什么。
QQ_AMBIENT_CHECK=300
QQ_AMBIENT_HEARD=8
# 每条群消息有多大比例会被"认真看一眼"（0–1）。这是成本闸，不是"说不说"的骰子：
# 默认 1 = 每条都看，"多久看一次"由下面的 CHECK 管。调到 0.05 会让群里消息少的时候
# 抽不到——那看起来就是她不理人，而原因只是运气。
QQ_AMBIENT_P=1.0
# 插话时有多大比例只用一张表情、不说话
QQ_AMBIENT_STICKER_P=0.3
# 插话时有多大比例**不是在接话**，而是说一句自己的事（没人叫她、也不回答谁）。
# 0 = 每次插话都是接上一句；1 = 每次都是自己的念头。0.35 大约是三次里一次。
QQ_AMBIENT_OWN_P=0.35
# 群里安静多少分钟后，她可能自己开口（分钟）。0 = 关掉（默认）。
# 打开后：安静满 N 分钟、距她自己上次说话超过 2N 分钟、并且每分钟掷一次 25% 的硬币，
# 三者都过才说一句；只在 9:00–23:00 之间。设 45 大概是「安静一个下午，她冒一两句」。
QQ_AMBIENT_IDLE=0
# 收录群友发的表情，并存下来，之后可以再用
QQ_STICKERS=1
# 让群友也能发 /表情 讨一张（唯一对群友开放的指令；每人 15 秒一次）。
# 设 0 就只剩 QQ_OWNER_IDS 能要表情。
QQ_STICKERS_PUBLIC=1
# 每周一几点发那张「上班」表情（0-23）；-1 关掉
QQ_MONDAY_HOUR=9
# 把说过的话写成一份记忆文件（characters/memory/*.md），每次重写整份，旧的被新的盖掉。
# 写在 characters/ 底下是为了在宿主机上直接能打开看、也能编辑。
QQ_DIGEST=1
# 私聊多久重写一次（天）。3 = 三天一次。
QQ_DIGEST_DM_DAYS=3
# 一个群多久重写一次（天）。7 = 每周一次。
QQ_DIGEST_GROUP_DAYS=7
# 写好的记忆要不要进提示词。1 = 她真的记得；0 = 只存档给你看，她不会想起来。
QQ_DIGEST_PROMPT=1
# 制作人从哪一档开始说话（new / familiar / close / inner，见 characters/world/fuyuko-qq.md）。
# 这是他的**下限**：说多少次都不会低于这一档。留空的话他和群里其他人一样，从「第一次说话」算起。
# 想让制作人一直是「自己人」，就填 inner。
QQ_OWNER_STAGE=close
# 制作人的好感度下限（0–100，0 = 不管）。好感度是判官按「这句话让她多难受」一分一分加减的，
# 它不知道「这一位是满好感」：他连着几次提同一个要求（比如一起住），就会被判成「在逼她」，
# 分数掉到「疏远」之后，她开始用对失望的人的语气说话。这个地板在判官之后生效，只抬制作人。
# 100 = 一直是「亲密」；90 = 留一点波动。
QQ_OWNER_AFFINITY=100
# 恋爱：两道门都要过——好感度 ≥ QQ_OWNER_LOVE（默认 95，比「亲密」的 85 高），
# 且和她说过 QQ_OWNER_LOVE_TURNS 次话（默认 20）。0 = 不启用，两人就一直停在「很喜欢」。
# 过了门会记一个标记：之后就算好感度掉下去也还在恋爱里（分手要改库，不是自动的）。
QQ_OWNER_LOVE=95
QQ_OWNER_LOVE_TURNS=20
# 恋爱之后的好感度下限。恋爱前是 QQ_OWNER_AFFINITY（100），恋爱后降到 90：
# 允许「今天有点不高兴」，但不会掉出恋爱；真掉下去了（特别伤到她）会保留 6 小时再抬回来。
QQ_OWNER_LOVE_FLOOR=90
# 恋爱之后她会不会先发消息过来（只在私聊里）。间隔是随机的，不是每天固定几条。
QQ_OWNER_LOVE_PING=1
QQ_OWNER_LOVE_PING_MIN=60
QQ_OWNER_LOVE_PING_MAX=150
# 指令权限：owner = 只有 QQ_OWNER_IDS 里的人能用 /阶段 /重载 /静音 这些，别人发了没有任何反应
# （/表情 例外，见 QQ_STICKERS_PUBLIC）；all = 群里谁都能用（会把指令表暴露给所有人）。
QQ_COMMANDS=owner
# 三层知识里哪几层开：office.md 的人名册、meta.md 的作品知识、对制作人的括号本性
QQ_WORLD=1
QQ_META=1
QQ_BRACKET=1
# 语音条：还没做，保持 0
QQ_VOICE=0

# ---- NapCat 的 WebUI 密码（必填，随便设一个强口令）
NAPCAT_WEBUI_TOKEN=
