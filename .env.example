# 配置：复制成 .env 再填。只有 CHAT_LLM_* 是必填的。
# 任何 OpenAI 兼容的服务都行（/chat/completions + stream）。
CHAT_LLM_BASE_URL=https://api.example.com/v1
CHAT_LLM_API_KEY=
CHAT_LLM_MODEL=

# 监听
SCCORE_HOST=0.0.0.0
SCCORE_PORT=8100

# 库与图片（默认在代码目录下；systemd 部署时指到 /var/lib/scbot）
SCCORE_DB=scbot.db
SCCORE_MEDIA=media

# 角色
SCCORE_CHARACTERS=characters
SCCORE_CHARACTERS_CONFIG=characters.toml

# 限额：每小时轮数、每小时图片张数；0 表示不限
SCCORE_TURNS_PER_HOUR=60
SCCORE_PHOTOS_PER_HOUR=8

# 带多少轮历史；0 表示全带
SCCORE_HISTORY_TURNS=20

# 判官模型：留空用对话模型；想省钱就指一个小模型
# 判官也可以另用一家服务（上游的 JEV 走 OpenRouter，就是这三行）
# SCCORE_JUDGE_MODEL=
# SCCORE_JUDGE_BASE_URL=https://openrouter.ai/api/v1
# SCCORE_JUDGE_API_KEY=

# 角色的资料：characters/facts/<id>.md 怎么进提示词
#   off     只有人设（默认）
#   whole   数据版：整份资料跟人设一起进提示词、一起被缓存
#   vector  向量版：按标题切段、嵌入，每轮只带最相关的几段（要下面的嵌入服务）
# SCCORE_RECALL=off
# SCCORE_RECALL_TOP=4
# SCCORE_RECALL_MIN=0.35
# 门控：judge = 每轮先让判断模型决定要不要查资料（上游用 JEV）
# SCCORE_RECALL_GATE=off

# 向量版的嵌入服务：任何 OpenAI 兼容的 /embeddings
# SCCORE_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# SCCORE_EMBEDDING_API_KEY=
# SCCORE_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# 记忆里的日期按哪个时区写
SCCORE_TIMEZONE=Asia/Shanghai

# 语音（Fish Audio）：留空则语音插件自动关
# FISH_AUDIO_API_KEY=
# FISH_AUDIO_BASE_URL=

# 假模型：1 = 不发任何请求，只回一段固定台词
# SCCORE_FAKE=1
