# QQ 通道的配置 —— 直接追加到内核的 .env 后面。
#
# 只有标了「必填」的三项是必须的：QQ_ENABLED、QQ_SELF_ID、QQ_CHARACTER，以及群号或私聊开关二选一。
# 其余全是默认值，先不改也能跑。

# ── 开不开 ────────────────────────────────────────────────────────────────
QQ_ENABLED=1
# 机器人自己的 QQ 号（小号）。用来过滤它自己发的消息、判断有没有被 @。必填。
QQ_SELF_ID=
# 用哪位角色的人格说话：`characters/characters.toml` 里的 id。必填，不猜。
QQ_CHARACTER=

# ── 连到 OneBot（NapCat） ─────────────────────────────────────────────────
# NapCat 的 WebSocket 服务器地址。同机默认 3001；docker compose 里是 ws://napcat:3001。
QQ_ONEBOT_WS=ws://127.0.0.1:3001
# NapCat 里设的 token；没设就留空。
QQ_ONEBOT_TOKEN=

# ── 待在哪儿 ──────────────────────────────────────────────────────────────
# 群号，逗号分隔。不是群名。
QQ_GROUP_IDS=
# 私聊总开关。开着的时候，只有下面名单里的人能一对一找她。
QQ_PRIVATE=0
QQ_PRIVATE_IDS=
# 完全不理会的人（群里刷屏的、别的机器人）。
QQ_IGNORE_IDS=

# ── 说话的方式 ────────────────────────────────────────────────────────────
# 同一个人连发几条，合并成一次回答的窗口（秒）。
QQ_MERGE_SECONDS=1.2
# 同一个人在群里说完之后，她多少秒内不再接他的话。
QQ_MEMBER_COOLDOWN=20
# 同时跑几个人的对话（模型并发）。机器弱就调小。
QQ_GROUP_CONCURRENCY=2
# 要不要把「对面是谁 / 能接多少 / 现在是几点」这几段规则放进提示词。
QQ_WORLD=1
QQ_META=1
QQ_BRACKET=1
# 语音（需要语音插件和 FISH_AUDIO_API_KEY）
QQ_VOICE=0

# ── 自己插话 ──────────────────────────────────────────────────────────────
QQ_AMBIENT=1
# 一天最多主动插话几次（所有群加在一起，0 = 不限）
QQ_AMBIENT_DAILY=10
# 两次「要不要插话」的判断之间至少隔多少秒（判断是一次模型请求）
QQ_AMBIENT_CHECK=300
# 每条群消息掷一次硬币，P 是「她要说点什么」的概率
QQ_AMBIENT_P=0.05
# 两次插话之间的最小间隔（秒）
QQ_AMBIENT_GAP=300
# 给她看的最近几行群聊
QQ_AMBIENT_HEARD=8
# 插话里有多大比例只发一张表情不说话
QQ_AMBIENT_STICKER_P=0.3
# 插话里有多大比例不是在接话，而是说一句自己的事（0 = 总在接话，1 = 总说自己的）
QQ_AMBIENT_OWN_P=0.35
# 群里安静多少分钟后她可能自己开口（分钟，0 = 关）。只在 9:00–23:00 之间。
QQ_AMBIENT_IDLE=0

# ── 表情 ──────────────────────────────────────────────────────────────────
# 收录群友发的表情，之后可以再用
QQ_STICKERS=1
# 群友也能发 /表情 讨一张
QQ_STICKERS_PUBLIC=1
# 表情图片存哪儿（留空 = 数据卷里的 media/stickers）
QQ_STICKER_DIR=
# 每周一几点发那张「上班」表情（0–23），-1 关掉
QQ_MONDAY_HOUR=9
# 谁能用指令（/重开 /好感 /静音 …）：owner = 只有主人；其它任何值 = 群里谁都能用
QQ_COMMANDS=owner

# ── 亲密关系（只对私聊里的主人生效） ──────────────────────────────────────
# 群里「对面」从哪一档开始：new / familiar / close / inner，留空 = 从最低档开始
QQ_OWNER_STAGE=close
# 主人的好感度地板（0–100，0 = 不管）。防止判官一路把她扣成"疏远"。
QQ_OWNER_AFFINITY=0
# 进入「恋爱」的门槛：好感度 >= 这个值，并且说过至少 N 次话
QQ_OWNER_LOVE=0
QQ_OWNER_LOVE_TURNS=20
# 恋爱之后的好感度地板
QQ_OWNER_LOVE_FLOOR=90
# 恋爱之后她会不定时先发消息（只在私聊）；间隔是这两者之间随机（分钟）
QQ_OWNER_LOVE_PING=0
QQ_OWNER_LOVE_PING_MIN=60
QQ_OWNER_LOVE_PING_MAX=150

# ── 记忆文件 ──────────────────────────────────────────────────────────────
# 把聊天写成 characters/memory/*.md（每次整份重写，新的盖掉旧的）
QQ_DIGEST=1
# 私聊多久重写一次（天）
QQ_DIGEST_DM_DAYS=3
# 一个群多久重写一次（天）
QQ_DIGEST_GROUP_DAYS=7
# 写好的记忆要不要进提示词（进，她才真的记得）
QQ_DIGEST_PROMPT=1

# ── 预留 ──────────────────────────────────────────────────────────────────
# 管理接口令牌。目前没有校验逻辑，留着给将来的 /api/qq/* 写接口用；改之前先看代码。
QQ_ADMIN_TOKEN=
